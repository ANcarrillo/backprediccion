# Copie este archivo como .env y ajuste los valores
DATABASE_URL=postgresql+psycopg://postgres:SU_CLAVE@localhost:5432/desercion_db

# Cambie esta clave (genere una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambie-esta-clave-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos (frontend), separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Carpeta donde ml/ guarda los modelos entrenados (.pkl + .json)
MODELS_DIR=../ml/models

# Reglas de riesgo
UMBRAL_RIESGO_MEDIO=0.40
UMBRAL_RIESGO_ALTO=0.70
ALERTA_RIESGO_MEDIO=true
REGLA_PROMEDIO_MINIMO=3.0
REGLA_ASISTENCIA_MINIMA=75
REGLA_MATERIAS_REPROBADAS=3
REGLA_HORAS_TRABAJO=30

# CAPTCHA del inicio de sesión (false = desactivado, p. ej. para usar Authorize en Swagger)
CAPTCHA_HABILITADO=true
CAPTCHA_VIGENCIA_SEGUNDOS=300
